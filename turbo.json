{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**", "apps/web/dist/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "format": {},
    "clean": {
      "cache": false
    },
    "preview": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
