---
interface Props {
	title: string;
}

const { title } = Astro.props;
import '../styles/global.css'; // Assume you have a global.css with Tailwind imports
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Automated Web Scanner Dashboard" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body class="bg-gray-50 min-h-screen text-gray-900 font-sans">
    <nav class="bg-white border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex">
            <a href="/" class="flex-shrink-0 flex items-center font-bold text-xl text-blue-600">
              AWA Scanner
            </a>
            <div class="hidden sm:ml-6 sm:flex sm:space-x-8">
              <a href="/" class="border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium">
                Dashboard
              </a>
              <a href="/runs" class="border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium">
                History
              </a>
              <a href="/tools/classify" class="border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium">
                Tools
              </a>
            </div>
          </div>
        </div>
      </div>
    </nav>
		<slot />
	</body>
</html>