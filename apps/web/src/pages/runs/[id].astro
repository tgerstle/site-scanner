---
import Layout from '../../layouts/Layout.astro';
import RunDetailHeader from '../../components/RunDetailHeader';
import PageResultTable from '../../components/PageResultTable';
import PerformanceInsights from '../../components/PerformanceInsights';
import { getRunDetails, getRunAlerts } from '../../lib/queries';

const { id } = Astro.params;
const run = getRunDetails(id!);
const alerts = getRunAlerts(id!) as any[];

if (!run) {
  return new Response(null, {
    status: 404,
    statusText: 'Not found'
  });
}
---

<Layout title={`Run ${id}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-6">
      <a href="/runs" class="text-blue-600 hover:text-blue-800 flex items-center gap-1 font-medium">
        &larr; Back to History
      </a>
    </div>

    <RunDetailHeader run={run} />

    {alerts.length > 0 && (
      <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 mb-6 rounded-r">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-yellow-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-yellow-800">Run Adjustments & Warnings</h3>
            <div class="mt-2 text-sm text-yellow-700">
              <ul class="list-disc pl-5 space-y-1">
                {alerts.map((alert: any) => (
                  <li key={alert.id}>{alert.message}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    )}

    <div class="mt-8">
      <PerformanceInsights client:load runId={run.id} />
    </div>

    <div class="mt-8">
      <h2 class="text-xl font-bold text-gray-900 mb-4 px-1">Pages Audit</h2>
      <PageResultTable client:load pages={run.pages} runId={run.id} />
    </div>
  </div>
</Layout>
