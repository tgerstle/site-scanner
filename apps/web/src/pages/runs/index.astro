---
import Layout from '../../layouts/Layout.astro';
import RunListTable from '../../components/RunListTable';
import { getRuns } from '../../lib/queries';

const runs = getRuns();
---

<Layout title="Scan History">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold text-gray-900">Scan History</h1>
      <a href="/" class="px-4 py-2 text-white bg-blue-600 rounded hover:bg-blue-700 transition-colors">
        New Scan
      </a>
    </div>

    <RunListTable client:load runs={runs} />
  </div>
</Layout>
