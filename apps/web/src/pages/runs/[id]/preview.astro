---
import Layout from '../../../layouts/Layout.astro';
import { ExportDataPreview } from '../../../components/ExportDataPreview';
import { getRunDetails } from '../../../lib/queries';

const { id } = Astro.params;
const run = getRunDetails(id!);

if (!run) {
  return new Response(null, {
    status: 404,
    statusText: 'Not found'
  });
}
---

<Layout title={`Export Preview - Run ${id}`}>
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-6 flex justify-between items-center border-b border-slate-200 pb-4">
      <div>
        <a href={`/runs/${id}`} class="text-blue-600 hover:text-blue-800 flex items-center gap-1 font-medium mb-2">
          &larr; Back to Run Details
        </a>
        <h1 class="text-2xl font-bold text-slate-800">Export Preview: {run.id}</h1>
      </div>
    </div>

    <ExportDataPreview client:load runId={run.id} />
  </div>
</Layout>
